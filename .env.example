# Copy to .env and edit. server.py does not read this file.
# run.ps1 and run.sh load it into the process environment.
# Do not put private keys, mnemonics, or supplier key material here.

HOST=127.0.0.1
PORT=8080
SERVICE_ID=relay-quote
SERVICE_VERSION=1.0.0
ROYALTY_RATE=0.025
MAIN_REST_URL=https://sauron-api.infra.pocket.network
BETA_REST_URL=https://sauron-api.beta.infra.pocket.network
UPSTREAM_DEADLINE_SECONDS=12
MAX_BODY_BYTES=1048576
